# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.
# ---------------------------------------------------------------

# Database — MySQL/MariaDB connection string
DATABASE_URL="mysql://user:password@localhost:3306/baylo"

# NextAuth — generate a secret with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary — image uploads (free at cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Pusher Channels — realtime (free at pusher.com → Channels → Create app)
PUSHER_APP_ID="your-app-id"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Email — SMTP credentials for password reset / notification emails
EMAIL_FROM="Baylo <no-reply@yourdomain.com>"
EMAIL_LOGO_URL="https://your-public-url.com/logo.png"
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER="your-gmail@gmail.com"
EMAIL_SMTP_PASS="your-app-password"

# PayMongo — use TEST/sandbox keys only, never live keys
PAYMONGO_SECRET_KEY="sk_test_xxxxxxxxxxxx"
# Register a webhook in the PayMongo dashboard (test mode), paste the whsk_test_... secret here
PAYMONGO_WEBHOOK_SECRET="whsk_test_xxxxxxxxxxxx"

# Anthropic API — for AI features (console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxx"

# ── Optional tuning (all have working defaults) ──────────────────────────
# Duplicate-image detection sensitivity. dHash distance: renamed/recompressed
# copy of the same photo ~0-8, a different image ~20+. Lower = stricter.
PHASH_THRESHOLD="10"
# What to do when a duplicate listing is confirmed: "block" | "warn" | "flag"
DUPLICATE_ACTION="block"
